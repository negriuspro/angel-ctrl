# ── Secrets & local config ─────────────────────────────
.env
*.pem
*.key

# ── Version control ────────────────────────────────────
.git/
.gitignore
.github/

# ── Python ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# ── Flutter/Dart source (build/web is included) ────────
frontend/lib/
frontend/test/
frontend/pubspec.*
frontend/analysis_options.yaml
frontend/.dart_tool/
frontend/.flutter-plugins*
