frontend/.idea/
frontend/web/

# ── Docs, scripts, IDE ─────────────────────────────────
docs/
scripts/
.idea/
.vscode/
*.iml
*.md

# ── Other services (not needed in build context) ───────
infra/mobile-core/
infra/jarvis-core/
infra/nginx/

