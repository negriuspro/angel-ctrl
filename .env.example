# ══════════════════════════════════════════════════════
#  Angel Ctrl — Variables de entorno
#  Copia este archivo a .env y completa los valores.
#  NUNCA subas .env a git.
# ══════════════════════════════════════════════════════

# ── Puerto de la app ───────────────────────────────────
APP_PORT=3000

# ── API Key interna (cambia esto por una clave fuerte) ─
# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# ── Redis ──────────────────────────────────────────────
# Genera con: python3 -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=CAMBIA_ESTO_POR_UNA_PASSWORD_FUERTE

# ── CORS Origins ───────────────────────────────────────
# IP local del servidor + IP Tailscale si usas VPN
# Ejemplo: http://192.168.1.100:3000,http://100.80.145.21:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5004,http://192.168.100.6:3005

# ── Ruta a datos de Claude Code ────────────────────────
# Ruta absoluta en el servidor Ubuntu donde está ~/.claude
CLAUDE_DATA_PATH=/home/angel/.claude

# ── API Keys de proveedores IA (dejar vacío si no se usa)
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
